proc loadModel { filename name s pos } {
  set obj [readModel $filename]

  setObjectValue $obj name $name

  setObjectValue $obj scale     [list $s $s $s] set
  setObjectValue $obj translate $pos

  return $obj
}

proc mapPos { pos } {
  set x [lindex $pos 0]
  set y [lindex $pos 1]
  set z [lindex $pos 2]

  set x1 [expr {$x*2}]
  set y1 [expr {$y*2}]
  set z1 [expr {$z*2}]

  return [list $x1 $y1 $z1]
}

addModelDir "Dungeon_Assets/obj"

proc tileFloor { model nx ny } {
  for {set iy 0} {$iy < $ny} {incr ny} {
    for {set ix 0} {$ix < $nx} {incr nx} {
      set tile($ix,$iy) [getObjectValue $model ref_object]

      set pos [mapPos $x 0 $y]

      setObjectValue $tile($ix,$iy) translate $pos
    }
  }
}

